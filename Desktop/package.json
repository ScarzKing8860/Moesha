{
  "name": "moesha-desktop",
  "version": "1.0.0",
  "description": "Desktop workspace for the Moesha AI Assistant",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.moesha.desktop",
    "productName": "Moesha",
      "../index.html",
      "../script.js",
      "../style.css",
      "../persona.css",
      "../img/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "Moesha.ico"
    },
    "nsis": {
      "shortcutName": "Moesha",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutDirName": "Moesha"
    }
  }
}
